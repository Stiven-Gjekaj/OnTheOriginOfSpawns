---
// One gene: its look, its tags, its pressure, its gains, and its downsides.
import Status from "./Status.astro";
import { famName, url } from "../lib/site.js";
import site from "../data/site.json";

interface Props { gene: any }
const { gene: g } = Astro.props;
const pressure = site.pressures.find((p) => p.id === g.counters);
const text = [g.name, g.gains, g.downsides, g.look, g.counters, g.details, famName(g.family), g.sub ? famName(g.sub) : ""].join(" ").toLowerCase();
// A gene with a mark on the back shows the back of the zombie.
const back = ["shade", "lurker"].includes(g.id);
---
<article class="gene" id={`gene-${g.id}`} style={`--fam:var(--${g.family})`} data-family={g.family} data-sub={g.sub || ""} data-text={text}>
  <div class="gene-top">
    <span class="mc-slot lg" data-tip-ref={`tip-gene-${g.id}`}>
      <canvas data-zombie data-genes={g.id} data-w="72" data-h="72" data-scale="2.05" data-cy="0.37" data-turn={back ? "2.6" : "-0.55"} aria-label={`The look of ${g.name}`}></canvas>
    </span>
    <div class="gene-title">
      <h3>{g.name}</h3>
      <div class="row tags">
        <span class="badge fam">{famName(g.family)}</span>
        {g.sub && <span class="badge fam sub" style={`--fam:var(--${g.sub})`}>sub {famName(g.sub)}</span>}
        <span class="badge pressure" data-tip={pressure?.when}>{g.counters}</span>
      </div>
    </div>
  </div>
  <dl>
    <div><dt class="gain">Gains</dt><dd>{g.gains}</dd></div>
    <div><dt class="loss">Downsides</dt><dd>{g.downsides}</dd></div>
    <div><dt>Look</dt><dd class="look">{g.look}</dd></div>
  </dl>
  {g.details && <details><summary>Details</summary><p>{g.details}</p></details>}
  <div class="gene-foot">
    <Status status={g.status} />
    <a class="btn sm" href={url(`lab/?genes=${g.id}`)}>Try it in the Gene Lab</a>
  </div>
</article>

<style>
  .gene {
    display: flex; flex-direction: column; gap: var(--s-4);
    padding: var(--s-5); background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg);
    box-shadow: var(--shadow); position: relative; overflow: hidden;
    transition: border-color 140ms ease, transform 140ms ease;
  }
  .gene::before { content: ""; position: absolute; inset: 0 auto 0 0; width: 3px; background: var(--fam); }
  .gene:hover { border-color: color-mix(in srgb, var(--fam) 45%, var(--border)); }
  .gene:target { border-color: var(--fam); box-shadow: 0 0 0 3px color-mix(in srgb, var(--fam) 25%, transparent); }
  .gene-top { display: flex; gap: var(--s-4); align-items: center; }
  .gene-title { display: grid; gap: var(--s-2); min-width: 0; }
  h3 { font-family: var(--font-display); font-weight: 600; font-size: var(--fs-lg); }
  .tags { gap: 6px; }
  dl { margin: 0; display: grid; gap: var(--s-3); font-size: var(--fs-sm); }
  dt { font-size: var(--fs-xs); font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-faint); margin-bottom: 2px; }
  dt.gain { color: var(--ok); }
  dt.loss { color: var(--predator); }
  dd { margin: 0; }
  .look { color: var(--text-muted); font-style: italic; }
  details { font-size: var(--fs-sm); color: var(--text-muted); }
  summary { cursor: pointer; font-weight: 600; color: var(--text); }
  details p { margin-top: var(--s-2); }
  .gene-foot { margin-top: auto; display: flex; justify-content: space-between; align-items: center; gap: var(--s-2); flex-wrap: wrap; padding-top: var(--s-3); border-top: 1px solid var(--border); }
</style>
