---
// The shared layout of each page: the head, the header, and the footer.
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { url } from "../lib/site.js";
import site from "../data/site.json";

interface Props {
  title?: string;
  description?: string;
}
const { title, description = "The wiki of On the Origin of Spawns, a Fabric mod where the mobs evolve from how you kill them." } = Astro.props;
const fullTitle = title ? `${title} | On the Origin of Spawns Wiki` : "On the Origin of Spawns Wiki";
const canonical = new URL(Astro.url.pathname, Astro.site);
// Each family takes the color of its slot. The five slots have the same five
// colors in each species. The tooltip sets the slots again, so it needs the
// names too.
const familyColors = `:root, .mc-tooltip, .mob-info { ${site.families.map((f) => `--${f.id}: var(--fam-${f.slot});`).join(" ")} }`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={url("img/icon.png")} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(url("img/banner.jpg"), Astro.site)} />
    <meta name="theme-color" content="#0c1114" />
    <style is:inline set:html={familyColors}></style>
    <script is:inline>
      // Set the saved color scheme before the first paint.
      try {
        const t = localStorage.getItem("oots-theme");
        if (t) document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Go to the content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <div class="mc-tooltip" id="tooltip" role="tooltip"></div>
    <script>
      import "../scripts/tooltip.js";
    </script>
  </body>
</html>
