---
import Layout from "../../layouts/Layout.astro";
import PageHeader from "../../components/PageHeader.astro";
import GeneTips from "../../components/GeneTips.astro";
import site from "../../data/site.json";
---
<Layout title="Gene Lab" description="Put genes on a zombie and see the gene marks and models of On the Origin of Spawns.">
  <PageHeader eyebrow="Gene Lab" title="Put genes on a zombie">
    The lab uses the real gene marks and gene models of the mod, and applies them in the same order as the game. The base skin is a flat drawing of the wiki, not the texture of the game.
  </PageHeader>
  <GeneTips />

  <div class="page container lab">
    <div class="stage-col">
      <div class="card stage-card">
        <div class="stage" id="lab-stage">
          <canvas id="lab-canvas" role="img" aria-label="A zombie with the selected genes"></canvas>
        </div>
        <div class="row controls">
          <button class="btn sm" type="button" id="lab-spin" aria-pressed="true">Turn</button>
          <button class="btn sm" type="button" id="lab-walk" aria-pressed="false">Walk</button>
          <button class="btn sm" type="button" id="lab-baby" aria-pressed="false" data-tip="Only the Runt gene makes baby zombies">Baby</button>
          <button class="btn sm" type="button" id="lab-night" aria-pressed="false">Night</button>
          <button class="btn sm ghost" type="button" id="lab-clear">Remove all</button>
        </div>
        <label class="angle"><span class="small muted">Angle</span><input id="lab-angle" type="range" min="-180" max="180" value="-29" /></label>
        <div class="result" id="lab-result" aria-live="polite"></div>
      </div>
    </div>

    <div class="pick-col">
      <div class="card">
        <div class="pick-head">
          <h2 class="h3">Genes</h2>
          <span class="badge" id="lab-count">0 of 5</span>
        </div>
        <p class="muted small">A zombie carries a maximum of 5 genes. The family result uses the rules of the mod. The Baby button fits the marks to a baby zombie, as the game does. Only the Runt gene makes baby zombies.</p>
        <p class="warn small" id="lab-msg" aria-live="polite"></p>
        {site.families.map((f) => (
          <fieldset class="fam-group" style={`--fam:var(--${f.id})`}>
            <legend>{f.name}</legend>
            <div class="toggles">
              {site.genes.filter((g) => g.family === f.id).map((g) => (
                <button class="toggle" type="button" data-gene={g.id} aria-pressed="false" data-tip-ref={`tip-gene-${g.id}`}>
                  <span class="check" aria-hidden="true"></span>{g.name}
                </button>
              ))}
            </div>
          </fieldset>
        ))}
      </div>
    </div>
  </div>
</Layout>

<script>
  import "../../scripts/lab.js";
</script>

<style>
  .lab { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); gap: var(--s-5); align-items: start; }
  @media (max-width: 900px) { .lab { grid-template-columns: 1fr; } }
  .stage-col { position: sticky; top: calc(var(--header-h) + var(--s-4)); }
  @media (max-width: 900px) { .stage-col { position: static; } }
  .stage-card { display: grid; gap: var(--s-4); }
  .stage {
    display: grid; place-items: center; border-radius: var(--radius); cursor: grab; touch-action: pan-y;
    background: linear-gradient(#cfe6f0, #a4c9d8);
    transition: background 400ms ease;
  }
  .stage.night { background: radial-gradient(60% 60% at 50% 35%, #1d2546, #090c17); }
  .stage canvas { width: min(100%, 340px); aspect-ratio: 3 / 4; image-rendering: pixelated; }
  .controls { justify-content: center; }
  .angle { display: grid; grid-template-columns: auto 1fr; gap: var(--s-3); align-items: center; }
  .result { display: grid; gap: var(--s-2); justify-items: center; text-align: center; }
  .pick-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--s-2); }
  .h3 { font-family: var(--font-sans); font-size: var(--fs-md); font-weight: 650; }
  .warn { color: var(--warn); min-height: 1.4em; margin-top: var(--s-1); }
  .fam-group { border: 0; padding: 0; margin: var(--s-4) 0 0; }
  .fam-group legend { font-size: var(--fs-xs); font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--fam); margin-bottom: var(--s-2); padding: 0; }
  .toggles { display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 6px; }
  .toggle {
    display: flex; align-items: center; gap: var(--s-2); min-height: 36px; padding: 0 var(--s-3);
    border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface);
    color: var(--text); font: 550 var(--fs-sm) / 1 var(--font-sans); cursor: pointer; text-align: left;
    transition: border-color 120ms ease, background 120ms ease;
  }
  .toggle:hover { border-color: var(--border-strong); }
  .toggle[aria-pressed="true"] { border-color: var(--fam); background: color-mix(in srgb, var(--fam) 10%, var(--surface)); }
  .check { flex: none; width: 14px; height: 14px; border-radius: 3px; border: 1.5px solid var(--border-strong); }
  .toggle[aria-pressed="true"] .check { background: var(--fam); border-color: var(--fam); box-shadow: inset 0 0 0 2px var(--surface); }
</style>
